{
  "entities": {
    "UserStats": {
      "title": "User Stats",
      "description": "Gamification metrics and progress for the user",
      "type": "object",
      "properties": {
        "totalXP": { "type": "integer", "description": "Total experience points earned" },
        "streak": { "type": "integer", "description": "Current daily login/task streak" },
        "lastActiveDate": { "type": "string", "format": "date-time", "description": "ISO timestamp of last activity" },
        "tasksCompleted": { "type": "integer", "description": "Total number of tasks completed" },
        "level": { "type": "integer", "description": "Current user level" }
      },
      "required": ["totalXP", "streak", "lastActiveDate", "tasksCompleted"]
    },
    "StudyJourney": {
      "title": "Study Journey",
      "description": "The overall academic roadmap and daily tasks",
      "type": "object",
      "properties": {
        "journey_title": { "type": "string", "maxLength": 200 },
        "current_milestone": { "type": "string", "maxLength": 200 },
        "total_estimated_days": { "type": "integer" },
        "daily_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "subject": { "type": "string" },
              "task_title": { "type": "string" },
              "completed": { "type": "boolean" },
              "xp_reward": { "type": "integer" },
              "priority": { "type": "string", "enum": ["low", "medium", "high"] }
            }
          }
        }
      }
    },
    "SubjectMastery": {
      "title": "Subject Mastery",
      "description": "Detailed progress tracking per subject",
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "modules": { "type": "array" }
            }
          }
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserStats",
      "description": "User progress and statistics"
    },
    "/journeys/{userId}": {
      "schema": "StudyJourney",
      "description": "The user's active study roadmap"
    },
    "/subject_mastery/{userId}": {
      "schema": "SubjectMastery",
      "description": "The user's subject-specific progress"
    }
  }
}
