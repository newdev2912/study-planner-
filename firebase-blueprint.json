{
  "entities": {
    "subject": {
      "title": "Academic Subject",
      "description": "An academic subject containing modules and topics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "deadline": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "deadline": { "type": "string" },
              "topics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "completed": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      },
      "required": ["id", "name", "modules"]
    },
    "stats": {
      "title": "User Statistics",
      "type": "object",
      "properties": {
        "totalXP": { "type": "integer" },
        "level": { "type": "integer" },
        "streak": { "type": "integer" },
        "tasksCompleted": { "type": "integer" },
        "lastActiveDate": { "type": "string", "format": "date-time" },
        "focusGoal": { "type": "string" },
        "journalEntries": { "type": "array" }
      }
    },
    "journey": {
      "title": "Study Journey",
      "type": "object",
      "properties": {
        "journey_title": { "type": "string" },
        "current_milestone": { "type": "string" },
        "total_estimated_days": { "type": "integer" },
        "daily_tasks": { "type": "array" }
      }
    },
    "task": {
      "title": "Daily Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "task_title": { "type": "string" },
        "estimated_minutes": { "type": "integer" },
        "completed": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "type": { "type": "string", "enum": ["regular", "subject"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastResetDate": { "type": "string", "format": "date" }
      }
    },
    "dailyFocusSession": {
      "title": "Daily Focus Session",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "items": { "type": "array" },
        "isActive": { "type": "boolean" },
        "totalTasks": { "type": "integer" },
        "completedTasks": { "type": "integer" }
      },
      "required": ["date", "items", "isActive", "totalTasks", "completedTasks"]
    },
    "publicUser": {
      "title": "Public User Profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email"]
    }
  },
  "firestore": {
    "/public_users/{userId}": {
      "schema": "publicUser",
      "description": "Public user info for quick login preset cards"
    },
    "/users/{userId}": {
      "schema": "stats",
      "description": "User's overall statistics and metadata"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": "subject",
      "description": "User's academic subjects"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "task",
      "description": "User's daily and subject-specific tasks"
    },
    "/users/{userId}/dailyFocusSessions/{date}": {
      "schema": "dailyFocusSession",
      "description": "User's daily focus sessions with staged and completed items"
    },
    "/users/{userId}/dailyLogs/{dateStr}": {
      "description": "User's daily activity logs for XP and completion tracking"
    },
    "/users/{userId}/userStats/{docId}": {
      "description": "User stats summary breakdown"
    },
    "/test/{docId}": {
      "description": "System test collection"
    },
    "/journeys/{userId}": {
      "schema": "journey",
      "description": "User's current study roadmap"
    }
  }
}
