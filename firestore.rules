rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Helpers ---
    function isValidUserStats(data) {
      return data.keys().hasAll(['totalXP', 'streak', 'lastActiveDate', 'tasksCompleted'])
        && data.totalXP is int
        && data.streak is int
        && data.lastActiveDate is string
        && data.tasksCompleted is int;
    }

    function isValidJourney(data) {
      return data.keys().hasAll(['journey_title', 'daily_tasks'])
        && data.journey_title is string
        && data.journey_title.size() <= 200
        && data.daily_tasks is list;
    }

    function isValidMastery(data) {
      return data.keys().hasAll(['subjects'])
        && data.subjects is list;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserStats(request.resource.data);
    }

    match /journeys/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidJourney(request.resource.data);
    }

    match /subject_mastery/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidMastery(request.resource.data);
    }
  }
}
