rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. MASTER DENY
    match /{document=**} {
      allow read, write: if false;
    }

    // GLOBALS
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // VALIDATION HELPERS
    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'name', 'modules'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.modules is list;
    }

    // SYSTEM TEST
    match /test/{docId} {
      allow read: if true;
    }

    // SUBJECTS COLLECTION
    match /users/{userId}/subjects/{subjectId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(subjectId) && isValidSubject(incoming());
      allow update: if isOwner(userId) && isValidSubject(incoming());
      allow delete: if isOwner(userId);
    }

    // USER DATA (STATS)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // JOURNEYS COLLECTION
    match /journeys/{userId} {
      allow read, write: if isOwner(userId);
    }

    // TASKS COLLECTION
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isOwner(userId);
    }

    // DAILY FOCUS SESSIONS COLLECTION
    match /users/{userId}/dailyFocusSessions/{date} {
      allow read, write: if isOwner(userId);
    }

    // LEGACY CLEANUP (OPTIONAL)
    match /subject_mastery/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
